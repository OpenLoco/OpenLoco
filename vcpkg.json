{
  "name": "openloco",
  "version-string": "22.02",
  "features": {
    "crashpad": {
      "description": "Enable Crashpad crash reporting dependency on supported Windows targets",
      "dependencies": [
        {
          "name": "crashpad",
          "platform": "windows & !uwp"
        }
      ]
    }
  },
  "dependencies": [
    "benchmark",
    "gtest",
    "libpng",
    "openal-soft",
    "yaml-cpp",
    "fmt",
    {
      "name": "sdl3",
      "default-features": false,
      "features": [
        {
          "name": "x11",
          "platform": "linux"
        },
        {
          "name": "wayland",
          "platform": "linux"
        }
      ]
    },
    {
        "name": "tbb",
        "platform": "linux"
    }
  ]
}
