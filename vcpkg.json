{
  "name": "openloco",
  "version-string": "22.02",
  "dependencies": [
    "benchmark",
    {
      "name": "breakpad",
      "platform": "windows"
    },
    "gtest",
    "libpng",
    "openal-soft",
    "yaml-cpp",
    "fmt",
    {
      "name": "sdl3",
      "default-features": false,
      "features": [
        {
          "name": "x11",
          "platform": "linux"
        },
        {
          "name": "wayland",
          "platform": "linux"
        }
      ]
    }
  ],
  "default-features": [
    "libstdcxx-execution"
  ],
  "features": {
    "libstdcxx-execution": {
      "description": "TBB backend that libstdc++ requires for <execution>",
      "dependencies": [
        {
          "name": "tbb",
          "platform": "linux"
        }
      ]
    }
  }
}
